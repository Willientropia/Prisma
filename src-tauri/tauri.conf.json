{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prisma",
  "version": "0.4.0",
  "identifier": "app.prisma",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Prisma",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": {
      "../resources/bibliotecas/": "bibliotecas/",
      "../resources/modelos/": "modelos/"
    },
    "fileAssociations": [
      {
        "ext": [
          "prsm"
        ],
        "name": "Caderno Prisma",
        "description": "Caderno Prisma",
        "mimeType": "application/x-prisma-caderno",
        "role": "Editor"
      },
      {
        "ext": [
          "prsf"
        ],
        "name": "Folha livre Prisma",
        "description": "Folha livre Prisma",
        "mimeType": "application/x-prisma-folha",
        "role": "Editor"
      },
      {
        "ext": [
          "prsl"
        ],
        "name": "Biblioteca Prisma",
        "description": "Biblioteca Prisma",
        "mimeType": "application/x-prisma-biblioteca",
        "role": "Editor"
      },
      {
        "ext": [
          "prst"
        ],
        "name": "Modelo Prisma",
        "description": "Modelo Prisma",
        "mimeType": "application/x-prisma-modelo",
        "role": "Editor"
      },
      {
        "ext": [
          "prsp"
        ],
        "name": "Projeto Prisma",
        "description": "Projeto Prisma",
        "mimeType": "application/x-prisma-projeto",
        "role": "Editor"
      }
    ],
    "publisher": "Prisma",
    "shortDescription": "Cálculo de engenharia"
  }
}
