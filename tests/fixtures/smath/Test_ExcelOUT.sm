    <region left="0" top="90" width="148" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold; font-style: italic; text-decoration: underline; font-family: Courier New; font-size: 8px;">EXCEL Input / Output:</p>
        </content>
      </text>
    </region>
    <region left="0" top="126" width="445" height="54" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">input</e>
          <e type="operand" style="string">yes</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">C6</e>
          <e type="operand">r</e>
          <e type="operand">3</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="string">Cow</e>
          <e type="operand" style="string">kind!</e>
          <e type="operand">100</e>
          <e type="operand">7</e>
          <e type="operand" style="string">is</e>
          <e type="operand">3</e>
          <e type="operand">2</e>
          <e type="function" args="8">mat</e>
          <e type="function" args="5">excel_IN</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="180" width="331" height="22" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">output</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">C1:D4</e>
          <e type="function" args="3">excel_OUT</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="270" width="606" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-style: italic; font-family: Courier New;">And to demonstrate simultaneous input/output, and how it works with units:</p>
        </content>
      </text>
    </region>
    <region left="0" top="306" width="366" height="22" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">input</e>
          <e type="operand" style="string">yes</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">I4</e>
          <e type="operand">5</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="5">excel_IN</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="351" width="526" height="41" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">A9</e>
          <e type="operand">2</e>
          <e type="operand" style="unit">kN</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="string"></e>
          <e type="operand" style="string"></e>
          <e type="operand">2</e>
          <e type="operand" style="unit">kN</e>
          <e type="operator" args="2">*</e>
          <e type="operand">5</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="function" args="1">eval</e>
          <e type="operand" style="string"></e>
          <e type="operand" style="string"></e>
          <e type="operand">2</e>
          <e type="operand" style="unit">kN</e>
          <e type="operator" args="2">*</e>
          <e type="operand">5</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operand">1</e>
          <e type="operand">7</e>
          <e type="function" args="9">mat</e>
          <e type="operand" style="string">C1:D4</e>
          <e type="function" args="5">excel_IO</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="414" width="200" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold; font-style: italic; text-decoration: underline; font-family: Courier New; font-size: 8px;">Creating Screenshot of EXCEL:</p>
        </content>
      </text>
    </region>
    <region left="0" top="450" width="603" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-family: Courier New; font-size: 8px;">png is created every time the formula is executed; it does not include row/column reference:</p>
        </content>
      </text>
    </region>
    <region left="0" top="477" width="411" height="22" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">PNGpath</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">A1:i9</e>
          <e type="operand" style="string">21.png</e>
          <e type="function" args="4">excel_PNGv0</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="513" width="552" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-family: Courier New; font-size: 8px;">png is created every time the formula is executed; it includes row/column reference:</p>
        </content>
      </text>
    </region>
    <region left="0" top="540" width="400" height="22" color="#000000" fontSize="8">
      <math error="42" errorLocation="5">
        <input>
          <e type="operand">PNGpath</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">A1:i9</e>
          <e type="operand" style="string">22.png</e>
          <e type="function" args="4">excel_PNG</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="576" width="635" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-family: Courier New; font-size: 8px;">png is creaded only when input or image cell region is changed; it includes row/column reference:</p>
        </content>
      </text>
    </region>
    <region left="0" top="603" width="411" height="22" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand">PNGpath</e>
          <e type="operand">EXCELpath</e>
          <e type="operand" style="string">Sheet1</e>
          <e type="operand" style="string">A1:i9</e>
          <e type="operand" style="string">22.png</e>
          <e type="function" args="4">excel_PNGv2</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="639" width="708" height="213" color="#000000" fontSize="8">
      <image>
        <imagefile filename="q0iez.png" lenght="111573" width="698" height="205" option="border=true;" dataRenderXmlLength="0" renderExt=".png" OLDwidht="714" OLDheight="224" select_rotation=""></imagefile>
        <input>
          <e type="operand">PNGpath</e>
        </input>
      </image>
    </region>
    <region left="0" top="873" width="532" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold; font-style: italic; text-decoration: underline; font-family: Courier New; font-size: 8px;">Making EXCEL visible after execution (default it is not visible, neither exited):</p>
        </content>
      </text>
    </region>
    <region left="0" top="900" width="230" height="22" color="#000000" fontSize="8">
      <math error="42" errorLocation="2">
        <input>
          <e type="operand" style="string">yes</e>
          <e type="operand">EXCELpath</e>
          <e type="function" args="2">excel_VISIBLE</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="936" width="360" height="20" color="#000000" fontSize="8" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold; font-style: italic; text-decoration: underline; font-family: Courier New; font-size: 8px;">Quitting EXCEL - THIS WILL CLOSE ALL EXCEL INSTANCES!:</p>
        </content>
      </text>
    </region>
    <region left="0" top="963" width="238" height="22" color="#000000" fontSize="8">
      <math error="9">
        <input>
          <e type="operand" style="string">no</e>
          <e type="operand" style="string">no</e>
          <e type="operand">EXCELpath</e>
          <e type="function" args="3">excel_QUIT</e>
        </input>
        <result action="numeric">
          <e type="operand">#</e>
        </result>
      </math>
    </region>
    <region left="0" top="990" width="454" height="23" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-family: Courier New;">first yes/no closes workbook, while 2nd quits the EXCEL</p>
        </content>
      </text>
    </region>
  </regions>
</worksheet>