{
  "name": "prisma",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:app": "tsx scripts/test-app.ts",
    "test": "npm run test:unit && npm run test:browser && npm run test:rust",
    "lint": "eslint .",
    "check:matriz": "tsx scripts/check-matriz.ts",
    "verify:rapido": "tsx scripts/verify-rapido.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:full": "tsx scripts/verify.ts --full",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "codemirror": "^6.0.2",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.8.10",
    "uplot": "^1.6.32",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "ast-v8-to-istanbul": "^1.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^9.32.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run test",
    "pre-push": "npm run verify"
  }
}
